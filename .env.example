# 复制为 .env 后修改。.env 不要提交到代码仓库。
DATABASE_URL=mysql+pymysql://ecom:改成你的数据库密码@127.0.0.1:3306/ecom_agent?charset=utf8mb4
# 只在首次初始化时生效；之后改这里不会改变 MySQL 实际的密码
MYSQL_ROOT_PASSWORD=改成root密码
JWT_SECRET=改成至少32位的随机字符串
# 只在首次启动时生效；之后修改要运行 python -m app.reset_admin
ADMIN_PASSWORD=改成管理员初始密码

# 外部大模型接口，默认通义千问；换其他 OpenAI 兼容服务时改这三项
LLM_BASE_URL=https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1
# 只在首次启动时写入数据库，之后请到“系统管理”修改模型名称
LLM_MODEL=qwen3.8-flash
# 手动填写 API Key；留空时读取系统环境变量 DASHSCOPE_API_KEY
LLM_API_KEY=
